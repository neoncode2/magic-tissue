{
  "projectName": "Magic Tissue - E-Commerce Landing Page",
  "version": "1.0.0",
  "description": "উচ্চ-রূপান্তরকারী ই-কমার্স ল্যান্ডিং পেজ, লাল থিম সংস্করণ",
  "theme": {
